# ============================================================================== 
# Environment Configuration for Autonomous AI Research Crew
# ==============================================================================

# Gemini API keys. Add one or more; keys are used with automatic quota fallback.
GEMINI_API_KEY_1="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"

# Tavily API Key (Required for live web research)
TAVILY_API_KEY="your-tavily-api-key-here"

# Optional: Disable CrewAI telemetry
OTEL_SDK_DISABLED="true"
